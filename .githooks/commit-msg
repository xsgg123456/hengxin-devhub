#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
if command -v python3 >/dev/null 2>&1 \
    && python3 -X utf8 -c "import sys" >/dev/null 2>&1; then
    python_cmd=python3
elif command -v python >/dev/null 2>&1 \
    && python -X utf8 -c "import sys" >/dev/null 2>&1; then
    python_cmd=python
else
    echo "❌ 未找到可用的 Python 3，无法校验 Git 提交信息。" >&2
    exit 1
fi

"$python_cmd" -X utf8 "$repo_root/.codex/hooks/harness_runtime.py" \
    pre-commit-gate
exec "$python_cmd" -X utf8 "$repo_root/.codex/hooks/harness_runtime.py" \
    validate-commit-message "$1"
