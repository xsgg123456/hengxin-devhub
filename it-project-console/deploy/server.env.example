# Copy to an absolute path outside the release directory; chmod 600 server.env.
# Never bundle the real file. Initialize reuses needed old credentials for NEW isolated volumes.
BIND_PORT=18080
POSTGRES_PASSWORD=replace-with-random-hex-password
# Match POSTGRES_PASSWORD above; percent-encode special characters in this URL.
DATABASE_URL=postgresql://it_project_console:replace-with-random-hex-password@postgres:5432/it_project_console
S3_ACCESS_KEY=replace-access-key
S3_SECRET_KEY=replace-with-random-secret-at-least-16-characters
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://your-existing-domain.example
S3_BUCKET=it-project-console
S3_REGION=us-east-1

# Existing DingTalk application and public HTTPS origin; no old database/session keys.
NEXTAUTH_URL=https://your-existing-domain.example
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
# Empty uses NEXTAUTH_URL + /api/auth/callback/dingtalk.
DINGTALK_REDIRECT_URI=
# Real DingTalk user ID for first administrator; no sample data seed is run.
BOOTSTRAP_ADMIN_DING_USER_ID=
DINGTALK_NOTIFICATIONS_ENABLED=false
DINGTALK_MANAGER_DIGEST_TIME=09:00
NODE_ENV=production
DEV_LOGIN=false
SESSION_HOURS=8
REQUESTS_PER_MINUTE=600
RISK_SCAN_CRON="* * * * *"
