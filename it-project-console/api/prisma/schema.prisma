generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  MANAGER
  ENGINEER
  BUSINESS
  @@map("role")
}
enum DemandStatus {
  DRAFT
  PENDING
  RETURNED
  REJECTED
  APPROVED
  WITHDRAWN
  @@map("demand_status")
}
enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  @@map("project_status")
}
enum MemberType {
  COLLABORATOR
  @@map("member_type")
}
enum AttachmentKind {
  FILE
  PRD
  PROTOTYPE
  @@map("attachment_kind")
}
enum AttachmentStatus {
  PENDING
  READY
  FAILED
  @@map("attachment_status")
}
enum OutboxStatus {
  PENDING
  SENT
  FAILED
  @@map("outbox_status")
}
model Department {
  id         String   @id @default(cuid())
  name       String
  dingDeptId String?  @unique @map("ding_dept_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  users      User[]
  @@map("departments")
}
model User {
  id               String               @id @default(cuid())
  name             String
  department       String
  departmentId     String?              @map("department_id")
  departmentRecord Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  dingUserId       String?              @unique @map("ding_user_id")
  dingUnionId      String?              @unique @map("ding_union_id")
  role             Role                 @default(BUSINESS)
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         Session[]
  demands          Demand[]
  ownedProjects    Project[]
  memberships      ProjectMember[]
  attachments      Attachment[]
  notifications    NotificationOutbox[]
  managerGrant     ManagerGrant?        @relation("GrantRecipient")
  grantsIssued     ManagerGrant[]       @relation("GrantIssuer")
  auditLogs        AuditLog[]
  @@index([departmentId])
  @@map("users")
}
model ManagerGrant {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  user        User     @relation("GrantRecipient", fields: [userId], references: [id], onDelete: Restrict)
  grantedById String?  @map("granted_by_id")
  grantedBy   User?    @relation("GrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("manager_grants")
}
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
model Demand {
  requestId String? @map("request_id")
  description String @default("")
  department String @default("")
  expectedLaunchDate DateTime? @map("expected_launch_date") @db.Date
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  reviewReason String? @map("review_reason")
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy String? @map("reviewed_by")
  version Int @default(1)
  prdUrl String? @map("prd_url")
  prototypeUrl String? @map("prototype_url")
  attachmentIds String[] @default([]) @map("attachment_ids")
  prdAttachmentId String? @map("prd_attachment_id")
  prototypeAttachmentId String? @map("prototype_attachment_id")
  id            String               @id @default(cuid())
  name          String
  status        DemandStatus         @default(DRAFT)
  ownerId       String               @map("owner_id")
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  attachments   Attachment[]
  project       Project?
  notifications NotificationOutbox[]
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([ownerId, status])
  @@map("demands")
}
model Project {
  requestId String? @map("request_id")
  source String @default("direct")
  department String @default("")
  priority String @default("P1")
  stage String @default("方案设计")
  simpleStatus String @default("not-started") @map("simple_status")
  overallProgress Float @default(0) @map("overall_progress")
  originalLaunchDate DateTime? @map("original_launch_date") @db.Date
  currentLaunchDate DateTime? @map("current_launch_date") @db.Date
  originalDeliveryDate DateTime? @map("original_delivery_date") @db.Date
  currentDeliveryDate DateTime? @map("current_delivery_date") @db.Date
  stageExpectedDate DateTime? @map("stage_expected_date") @db.Date
  lastOverallUpdatedAt DateTime @default(now()) @map("last_overall_updated_at") @db.Timestamptz(3)
  version Int @default(1)
  blocker String @default("")
  risks Json @default("[]")
  riskVersion Int @default(0) @map("risk_version")
  progressUpdates ProgressUpdate[]
  scheduleChanges ScheduleChange[]
  riskSnapshots RiskSnapshot[]
  stageHistories StageHistory[]
  id             String               @id @default(cuid())
  name           String
  status         ProjectStatus        @default(ACTIVE)
  archived       Boolean              @default(false)
  demandId       String?              @unique @map("demand_id")
  demand         Demand?              @relation(fields: [demandId], references: [id], onDelete: Restrict)
  primaryOwnerId String               @map("primary_owner_id")
  primaryOwner   User                 @relation(fields: [primaryOwnerId], references: [id], onDelete: Restrict)
  members        ProjectMember[]
  notifications  NotificationOutbox[]
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([primaryOwnerId])
  @@map("projects")
}
model ProjectMember {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  type      MemberType @default(COLLABORATOR)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}
model Attachment {
  id               String           @id @default(cuid())
  demandId         String           @map("demand_id")
  demand           Demand           @relation(fields: [demandId], references: [id], onDelete: Restrict)
  uploaderId       String           @map("uploader_id")
  uploader         User             @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  kind             AttachmentKind
  name             String
  mime             String
  size             Int
  objectKey        String           @unique @map("object_key")
  stagingCleanedAt DateTime?        @map("staging_cleaned_at") @db.Timestamptz(3)
  status           AttachmentStatus @default(PENDING)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([demandId, status])
  @@index([status, expiresAt])
  @@map("attachments")
}
model NotificationOutbox {
  deliveryLog NotificationLog?
  id             String       @id @default(cuid())
  recipientId    String       @map("recipient_id")
  recipient      User         @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  eventType      String       @map("event_type")
  demandId       String?      @map("demand_id")
  demand         Demand?      @relation(fields: [demandId], references: [id], onDelete: Restrict)
  projectId      String?      @map("project_id")
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  idempotencyKey String       @unique @map("idempotency_key")
  payload        Json
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([status, availableAt])
  @@map("notification_outbox")
}
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("system_settings")
}
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
model StageHistory {
  id String @id @default(cuid())
  projectId String @map("project_id")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage String
  status String
  enteredAt DateTime? @map("entered_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  expectedDate DateTime? @map("expected_date") @db.Date
  progress Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  interruptedAt DateTime? @map("interrupted_at") @db.Timestamptz(3)
  @@index([projectId, stage])
  @@map("stage_histories")
}
model CommandReceipt {
  id String @id @default(cuid())
  actorId String @map("actor_id")
  key String
  hash String
  response Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([actorId, key])
  @@map("command_receipts")
}
model ObjectDeletion {
  id String @id @default(cuid())
  objectKey String @unique @map("object_key")
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  attempts Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("object_deletions")
}
