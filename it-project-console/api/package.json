{
  "name": "@it-project-console/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "generate": "prisma generate",
    "typecheck": "pnpm generate && tsc --noEmit",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "tsx --env-file-if-exists=.env scripts/integration.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:browser": "tsx --env-file-if-exists=.env scripts/browser-integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1126.0",
    "@aws-sdk/s3-request-presigner": "3.1126.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.3.1",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "node-cron": "4.6.0",
    "pg": "8.20.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.0.5",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
