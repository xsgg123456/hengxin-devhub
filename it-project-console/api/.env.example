NODE_ENV=development
DEV_LOGIN=false
HOST=127.0.0.1
PORT=4322
WEB_ORIGIN=http://127.0.0.1:4318
DATABASE_URL=postgresql://it_project_console:replace-password@127.0.0.1:55432/it_project_console
S3_ENDPOINT=http://127.0.0.1:59000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:59000
S3_BUCKET=it-project-console
S3_ACCESS_KEY=replace-access-key
S3_SECRET_KEY=replace-with-random-secret

# 风险快照每分钟重算，时区固定上海
RISK_SCAN_CRON="* * * * *"

# 同出口团队共享的 IP 请求上限，登录单独限流
REQUESTS_PER_MINUTE=600

# 钉钉企业应用：不复制旧系统数据库或会话密钥
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
# 兼容旧 DINGTALK_APP_KEY/SECRET、NEXTAUTH_URL；非空新配置优先。
# 未填回调时按 WEB_ORIGIN（或 NEXTAUTH_URL）生成 /api/auth/callback/dingtalk。
# 切换沿用旧回调，不要求修改开放平台。
DINGTALK_REDIRECT_URI=
BOOTSTRAP_ADMIN_DING_USER_ID=
# 只有确认真实联调收件人和样例隔离后才开启
DINGTALK_NOTIFICATIONS_ENABLED=false
DINGTALK_MANAGER_DIGEST_TIME=09:00
