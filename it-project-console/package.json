{
  "name": "it-project-console",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @it-project-console/web dev",
    "dev:api": "pnpm --filter @it-project-console/api dev",
    "setup:local": "node scripts/setup-local.mjs",
    "audit:api": "node scripts/audit-api.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @it-project-console/web test:e2e",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  }
}
